# AUR PKGBUILD template for Java Control Centre
# Copy to an AUR package directory together with .SRCINFO generated by `makepkg --printsrcinfo`.
pkgname=java-control-centre
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop control centre for JDKs, JVM processes, memory, GC, threads, heap dumps and Spring Boot Actuator"
arch=('x86_64')
url="https://github.com/saswinkumar017/java-ctrl"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'jdk17-openjdk')
makedepends=('git' 'nodejs' 'npm' 'rust' 'cargo' 'base-devel' 'patchelf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/saswinkumar017/java-ctrl/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/java-control-centre-$pkgver"
  npm ci
  npm run tauri build -- --bundles deb
}

package() {
  cd "$srcdir/java-control-centre-$pkgver"
  install -Dm755 "src-tauri/target/release/jcc" "$pkgdir/usr/bin/java-control-centre"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/java-control-centre.png"
}
